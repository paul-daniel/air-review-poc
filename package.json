{
  "name": "air-review",
  "version": "0.3.0",
  "description": "Contextual AI code review CLI with API-key providers, local review memory and per-role cost reporting.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "air-review": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "schema": "npm run build && node dist/scripts/generate-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "demo": "npm run build && node scripts/demo.mjs",
    "test:api": "npm run build && node scripts/test-local-api.mjs",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "code-review",
    "ai",
    "github",
    "ollama",
    "angular",
    "cli"
  ],
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^1.1.1",
    "@azure/ai-projects": "^2.10.0",
    "@azure/identity": "^4.14.1",
    "@octokit/rest": "^21.1.1",
    "chalk": "^6.0.1",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.0",
    "openai": "^7.47.0",
    "smol-toml": "^1.3.4",
    "string-width": "^8.3.0",
    "typescript": "^5.8.0",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.7.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript-eslint": "8.70.1",
    "vitepress": "1.6.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-daniel/air-review-poc.git"
  }
}
